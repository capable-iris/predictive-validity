# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Neon Postgres — ask a maintainer for credentials, or provision your own
# and run db/01_schema.sql against it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required to re-run any of the LLM classifiers in analyses/classifiers/:
#   - score_target_literature.py        (Line B/C/D/E scorer per target)
#   - classify_why_stopped_haiku.py     (trial termination cats)
#   - classify_why_stopped_sonnet.py    (verification pass)
#   - classify_silent_kill.py           (Ph3+ silent-kill verify)
#   - nelson_tier_classify.py           (T-I Nelson tier assignment)
# Also needed for the Claude Code CLI-based scorers (13_llm_agent_scorer.py).
# See analyses/classifiers/README.md for cost estimates and rerun procedure.
# ANTHROPIC_API_KEY=sk-ant-...
